# Template for the app's two env files (this one is committed; the real ones are git-ignored):
#   .env.development   LOCAL       npm run dev                                   → backend on this computer
#   .env.production    PRODUCTION  next build: npm run build, cap:android, cap:ios → the live backend
# Copy this file to both and fill in the values. Vercel and GitHub Actions get the same values in their settings.
#
# Why not ".env.local": Next.js loads .env.local for every build, including release builds, so a localhost address
# there would end up in the Play Store app. .env.development is only ever used by `npm run dev`.
#
# Everything here is built into the app and visible to anyone who has it: never put a secret here.

# Where the backend is:
#   .env.development   http://localhost:3001    (Android emulator: http://10.0.2.2:3001)
#   .env.production    https://reclimate-backend--reclimate-d0868.asia-southeast1.hosted.app
NEXT_PUBLIC_API_URL=

# Firebase web config, the same in both files (Firebase console → Project settings → Your apps → Web app).
# Public by design: it identifies the project, it is not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=reclimate-d0868.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reclimate-d0868
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=reclimate-d0868.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
