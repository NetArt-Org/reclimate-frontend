# Copy to .env.local. NEXT_PUBLIC_ values are baked into the app at build time
# and are visible to anyone who has the app — never put secrets here.

# Where the backend (backend-reclimate-dmrv) is reachable from the device:
#   browser on this computer   http://localhost:3001
#   iOS simulator              http://localhost:3001
#   Android emulator           http://10.0.2.2:3001
#   real phone                 https://<your deployed backend>
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional, demo only: phone numbers pre-filled when a role is tapped on the login screen.
NEXT_PUBLIC_DEMO_WORKER_PHONE=
NEXT_PUBLIC_DEMO_SUPERVISOR_PHONE=
