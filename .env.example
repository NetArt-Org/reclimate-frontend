# Copy to .env.local. NEXT_PUBLIC_ values are baked into the app at build time
# and are visible to anyone who has the app — never put secrets here.

# The backend address is set per build, not here: .env.development (npm run dev → http://localhost:3001) and
# .env.production (next build / Play Store → https://reclimate-backend--reclimate-d0868.asia-southeast1.hosted.app).
# Don't put NEXT_PUBLIC_API_URL in .env.local: it overrides both, including release builds.
# Other addresses, for reference:
#   browser on this computer   http://localhost:3001
#   iOS simulator              http://localhost:3001
#   Android emulator           http://10.0.2.2:3001
#   real phone                 https://<your deployed backend>
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Firebase web config (the same project as the backend's admin sign-in). These identify the project; they are
# public by design. Copy them from the backend's .env (NEXT_PUBLIC_FIREBASE_*) or the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
