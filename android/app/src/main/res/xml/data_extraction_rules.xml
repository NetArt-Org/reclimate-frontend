<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to another device: the app keeps a copy of the person's work and sign-in,
     which must stay on this phone (Android 12+; older versions follow allowBackup="false"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
