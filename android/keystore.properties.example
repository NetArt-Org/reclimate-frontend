# Copy to android/keystore.properties (git-ignored) to sign release builds for the Play Store.
# Create the key once and keep it safe — an app on Play can only be updated with the same key:
#   keytool -genkey -v -keystore artisan-pro-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias artisan-pro
storeFile=../artisan-pro-release.jks
storePassword=
keyAlias=artisan-pro
keyPassword=
